# Inquiry form -> email (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered (comma-separate for several)
INQUIRY_TO_EMAIL=
# Optional. Needs a domain verified in Resend; until then the default sandbox sender
# (onboarding@resend.dev) only delivers to the email your Resend account was created with.
# INQUIRY_FROM_EMAIL="Capivora Website <inquiries@yourdomain.com>"
# Your live domain. Used for SEO: canonical URL, sitemap, robots.txt, structured data
# and social share previews. Required in production (unless deployed on Vercel).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
